---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { contacts, whatsappUrl, emailUrl, heroImages, aboutPhotos } from '../lib/contacts';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const waUrl = whatsappUrl();
const mailUrl = emailUrl();
const hero = heroImages();
const about = aboutPhotos();

// CSS escape simples para URLs em background-image
function cssUrl(s: string) {
  return s.replace(/[\\'"]/g, '\\$&');
}
---

<BaseLayout
  title="<BaseLayout
  title="Fernanda Okabayashi | Arquitetura e Interiores"
  description="Projetos Arquitetônicos, Interiores, Avaliação de Imóveis e INSS de oobras."
>."
>
  <!-- HERO -->
  <section
    class={`hero ${hero ? 'hero-with-photo' : ''}`}
    id="topo"
    style={hero
      ? `--hero-image: url('${cssUrl(hero.desktop)}'); --hero-image-mobile: url('${cssUrl(hero.mobile)}');`
      : ''}
  >
    <div class="hero-overlay" aria-hidden="true"></div>
    <div class="container hero-inner">
<div class="hero-text">
  <span class="eyebrow">
    FERNANDA OKABAYASHI
  </span>

  <h1>
    Arquitetura e interiores<br />
    com elegância,<br />
    funcionalidade e identidade.
  </h1>

  <p class="lead">
   Arquitetura, interiores, avaliação imobiliária e regularização de obras reunidos em um único escritório. Soluções completas com excelência técnica, atendimento personalizado e compromisso com resultados.
  </p>

  <div class="hero-cta">
    <a
      href={waUrl ?? mailUrl ?? '#contato'}
      class="btn btn-brand"
      {...(waUrl ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
    >
  
      Solicitar orçamento
    </a>

    <a href="#servicos" class="btn btn-secondary">
      Conheça nossos serviços
    </a>
  </div>
</div>

  <!-- SOBRE -->
  <section id="sobre" class="section">
    <div class="container">
      <div class={`who-block ${about ? 'who-block-with-photo' : ''}`}>
        <div class="who-text">
          <span class="eyebrow">Quem atende você</span>
          <h2>Fernanda Okabayashi</h2>
          <div class="divider"></div>
          <p>
            A <strong>Fernanda OKabayashi Arquitetura e Interiores </strong> é a marca-assinatura da arquiteta <strong>Fernanda Okabayashi</strong> — organizada, direta, voltada Porjetos Arquitetônicos e Interiores, avaliações imobiliárias em prazo curto para instituições financeiras e redução de INSS de obras
          </p>
          <p>
          
<p class="lead-quote">
            "Ordem e clareza em cada laudo."
          </p>
        </div>
        {about && (
          <picture class="about-photo-wrap">
            <source srcset={about.mobile} media="(max-width: 768px)" />
            <img src={about.desktop} alt="Fernanda Okabayashi" class="about-photo" />
          </picture>
        )}
      </div>

       
  <!-- SERVIÇOS -->
  <section id="servicos" class="section tinted">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">O que entregamos</span>
        <h2>Serviços</h2>
        <div class="divider"></div>
        <p class="lead">Projetos inteligentes, avaliações confiáveis e regularização especializada para oferecer mais segurança, praticidade e valorização ao seu imóvel.</p>
      </div>

      <div class="grid grid-2">
        <div class="card service-card">
          <h3>Projetos  Arquitetônicos </h3>
          <p>Projetos residenciais e comerciais desenvolvidos para transformar necessidades em espaços funcionais, modernos e personalizados, conciliando estética, conforto e viabilidade técnica.</p>
        </div>
        <div class="card service-card">
          <h3>Laudos avaliação de imóveis</h3>
          <p>Realizamos avaliações imobiliárias seguindo as normas da ABNT e os critérios das instituições financeiras, oferecendo laudos técnicos confiáveis para financiamentos, compra e venda, inventários e diversas outras finalidades..</p>
        </div>
        <div class="card service-card">
          <h3>Projeto de Interiores</h3>
          <p>Criamos ambientes exclusivos que refletem o estilo de cada cliente, com planejamento completo de layout, iluminação, marcenaria e acabamentos, proporcionando beleza, funcionalidade e bem-estar.</p>
        </div>
        <div class="card service-card">
          <h3>INSS de obras </h3>
          <p>Regularização de INSS de Obras para Pessoa Física e Pessoa Jurídica, com acompanhamento técnico especializado.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- DIFERENCIAL -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Diferencial</span>
        <h2>"Oferecemos um atendimento completo, reunindo arquitetura, interiores, avaliação imobiliária e regularização de INSS de obras em um único escritório.

Nosso compromisso é entregar segurança técnica, transparência e soluções personalizadas que valorizam o seu imóvel e proporcionam tranquilidade em cada etapa."</h2>
        <div class="divider"></div>
        <p class="lead">Projetamos com criatividade, avaliamos com precisão e regularizamos com responsabilidade.</p>
      </div>

  

  <!-- BLOG PREVIEW -->
  {posts.length > 0 && (
    <section class="section tinted">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">Conteúdo técnico</span>
          <h2>Do blog</h2>
          <div class="divider"></div>
          <p class="lead">Conteúdo autoral sobre avaliação imobiliária, laudos técnicos e financiamento bancário — escrito pela arquiteta a partir do que se vê na prática com Caixa, BB e bancos privados.</p>
        </div>

        <div class="grid grid-3">
          {posts.map((post) => (
            <a href={`/blog/${post.id}`} class="card">
              <span class="post-date">{post.data.pubDate.toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' })}</span>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
              <span class="card-link">Ler →</span>
            </a>
          ))}
        </div>

        <div class="text-center" style="margin-top: 48px;">
          <a href="/blog" class="btn btn-secondary">Ver todos os posts</a>
        </div>
      </div>
    </section>
  )}

  <!-- CONTATO -->
  <section id="contato" class="section">
    <div class="container">
      <div class="section-head section-head-center">
        <span class="eyebrow">Atendimento direto</span>
        <h2>Pra cada laudo, uma conversa antes do orçamento.</h2>
        <div class="divider"></div>
        <p class="lead">
          Conte qual o imóvel, qual o banco e qual o prazo. Em uma conversa direta com a arquiteta, você sai com escopo, prazo e investimento claros — e a entrega acontece na forma certa, na primeira versão.
        </p>
      </div>

      {(waUrl || mailUrl) && (
        <div class="contact-cta-wrap">
          {waUrl ? (
            <a href={waUrl} class="btn btn-cta-large" target="_blank" rel="noopener noreferrer">
              Falar com especialista
            </a>
          ) : (
            <a href={mailUrl!} class="btn btn-cta-large">
              Falar com especialista
            </a>
          )}
          <p class="contact-cta-sub">Atendimento direto com Fernanda</p>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    --hero-image: linear-gradient(135deg, var(--primary) 0%, var(--dark) 100%);
    --hero-image-mobile: var(--hero-image);
    background-color: var(--dark);
    background-image: var(--hero-image);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    color: #fff;
    padding: 120px 0 100px;
    overflow: hidden;
    position: relative;
    min-height: 600px;
    display: flex;
    align-items: center;
  }

  @media (max-width: 768px) {
    .hero { background-image: var(--hero-image-mobile); }
    .hero-overlay {
      background:
        /* mobile: gradiente vertical de baixo pra cima (texto fica na metade superior) */
        linear-gradient(
          180deg,
          rgba(7, 11, 17, 0.55) 0%,
          rgba(7, 11, 17, 0.70) 35%,
          rgba(7, 11, 17, 0.85) 100%
        ),
        radial-gradient(circle at 80% 15%, rgba(var(--brand-glow-rgb), 0.25), transparent 60%);
    }
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background:
      /* feather preto forte da esquerda → transparente à direita */
      linear-gradient(
        to right,
        rgba(7, 11, 17, 0.95) 0%,
        rgba(7, 11, 17, 0.85) 20%,
        rgba(7, 11, 17, 0.60) 42%,
        rgba(7, 11, 17, 0.25) 60%,
        rgba(7, 11, 17, 0.05) 80%,
        rgba(7, 11, 17, 0) 100%
      ),
      /* leve escurecimento geral pra unificar */
      linear-gradient(180deg, rgba(0, 0, 0, 0.18) 0%, rgba(0, 0, 0, 0.35) 100%),
      /* mancha quente sutil de marca no canto superior direito */
      radial-gradient(circle at 92% 15%, rgba(var(--brand-glow-rgb), 0.22), transparent 50%);
    pointer-events: none;
    z-index: 1;
  }

  /* sem foto: gradiente original mais forte pra cobrir o fundo padrão */
  .hero:not(.hero-with-photo) .hero-overlay {
    background:
      linear-gradient(135deg, rgba(31, 42, 56, 0.6) 0%, rgba(15, 20, 25, 0.85) 100%),
      radial-gradient(circle at 80% 20%, rgba(var(--brand-glow-rgb), 0.25), transparent 50%);
  }

  .hero-text h1 {
    text-shadow: 0 2px 32px rgba(0, 0, 0, 0.7), 0 1px 2px rgba(0, 0, 0, 0.4);
  }
  .hero-text .lead {
    text-shadow: 0 2px 16px rgba(0, 0, 0, 0.55);
  }
  .hero-text .eyebrow {
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.5);
  }

.hero-inner{
    display:grid;
    grid-template-columns:1.4fr 1fr;
    gap:64px;
    align-items:center;
    position:relative;
    z-index:2;
    width:100%;
}

.hero-text{
    max-width:720px;
}
}
display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 64px;
    align-items: center;
    position: relative;
    z-index: 2;
    width: 100%;
  }

  .hero-with-photo .hero-inner {
    grid-template-columns: minmax(0, 720px);
  }

  .hero h1{
    color:#fff;
    margin-bottom:28px;
    font-size:clamp(54px,7vw,92px);
    line-height:1.05;
}

.hero .lead{
    color:rgba(255,255,255,.90);
    font-size:22px;
    max-width:620px;
    margin-bottom:42px;
}

  .hero .eyebrow { color: var(--secondary-on-dark); }

  .hero-cta {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  .hero .btn-secondary {
    border-color: rgba(255,255,255,0.4);
    color: #fff;
  }

  .hero .btn-secondary:hover {
    background: #fff;
    color: var(--primary);
    border-color: #fff;
  }

  .hero-visual {
    display: flex;
    justify-content: center;
    align-items: center;
    opacity: 0.96;
  }

  .hero-visual .hero-mark {
    max-width: 360px;
    width: 100%;
    filter: drop-shadow(0 24px 64px rgba(0,0,0,0.35));
  }

  @media (max-width: 900px) {
    .hero { padding: 96px 0 80px; min-height: 480px; }
    .hero-inner { grid-template-columns: 1fr; }
    .hero-visual { order: -1; }
    .hero-visual .hero-mark { max-width: 200px; }
  }

  .section-head {
    margin-bottom: 64px;
    max-width: 720px;
  }

  .section.tinted .section-head .lead { color: var(--gray-700); }

  .service-card h3 { color: var(--primary); }

  .card-link {
    display: inline-block;
    margin-top: 16px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: var(--secondary);
  }

  .reasons-grid { gap: 48px; }

  .reason-num {
    font-family: var(--display);
    font-size: 56px;
    font-weight: 400;
    color: var(--secondary);
    line-height: 1;
    margin-bottom: 12px;
  }

  .reason h3 { color: var(--primary); }

  .who-block {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
    align-items: start;
    margin-bottom: 80px;
  }

  .who-block-with-photo {
    grid-template-columns: 1.2fr 1fr;
    gap: 80px;
  }

  .who-text p {
    margin-bottom: 16px;
    color: var(--gray-700);
    font-size: 17px;
  }

  .about-photo-wrap {
    aspect-ratio: 4 / 5;
    border-radius: 14px;
    overflow: hidden;
    background: var(--gray-100);
    box-shadow: 0 16px 40px rgba(31, 42, 56, 0.12);
    display: block;
  }
  .about-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .mvv-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .lead-quote {
    font-family: var(--display);
    font-style: italic;
    font-size: 22px;
    line-height: 1.4;
    color: var(--secondary);
    border-left: 3px solid var(--secondary);
    padding-left: 20px;
    margin-top: 24px;
  }

  .mvv-card {
    background: var(--gray-100);
    border-left: 3px solid var(--secondary);
    padding: 28px 28px;
    border-radius: 4px;
  }

  .mvv-card p {
    color: var(--gray-900);
    font-size: 15px;
    margin: 0;
    line-height: 1.6;
  }

  @media (max-width: 900px) {
    .who-block,
    .who-block-with-photo { grid-template-columns: 1fr; gap: 40px; }
    .about-photo-wrap { max-width: 360px; aspect-ratio: 3 / 4; }
    .mvv-row { grid-template-columns: 1fr; gap: 16px; }
  }

  .post-date {
    display: block;
    font-family: var(--body);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--gray-500);
    margin-bottom: 12px;
  }

  .section-head-center {
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }
  .section-head-center .divider { margin-left: auto; margin-right: auto; }

  .contact-cta-wrap {
    text-align: center;
    margin-bottom: 48px;
  }

  .btn-cta-large {
    font-size: 17px;
    padding: 20px 40px;
    background: var(--secondary);
    color: #fff;
    border: 1.5px solid var(--secondary);
    box-shadow: 0 12px 32px rgba(var(--brand-glow-rgb), 0.25);
    transition: all var(--transition);
  }
  .btn-cta-large:hover {
    background: #fff;
    color: var(--secondary);
    border-color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 18px 40px rgba(var(--brand-glow-rgb), 0.32);
  }

  .contact-cta-sub {
    margin-top: 16px;
    font-size: 14px;
    color: var(--gray-500);
  }

</style>
