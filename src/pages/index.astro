---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { contacts, whatsappUrl, emailUrl, heroImages, aboutPhotos } from '../lib/contacts';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const waUrl = whatsappUrl();
const mailUrl = emailUrl();
const hero = heroImages();
const about = aboutPhotos();

// CSS escape simples para URLs em background-image
function cssUrl(s: string) {
  return s.replace(/[\\'"]/g, '\\$&');
}
---

<BaseLayout
  title= "Fernanda Okabayashi Arquitetura e Interiores | Avaliação de Imóveis | INSS de obras"
>
  <!-- HERO -->
  <section
    class={`hero ${hero ? 'hero-with-photo' : ''}`}
    id="topo"
    style={hero
      ? `--hero-image: url('${cssUrl(hero.desktop)}'); --hero-image-mobile: url('${cssUrl(hero.mobile)}');`
      : ''}
  >
    <div class="hero-overlay" aria-hidden="true"></div>
    <div class="container hero-simple">

  <span class="eyebrow">
    Fernanda Okabayashi Arquitetura e Interiores
  </span>

  <h1>
    Arquitetura que valoriza
    <br />
    o seu patrimônio.
  </h1>

  <p class="lead">
    Projetos Arquitetônicos, Projetos de Interiores, Avaliações de Imóveis -  Credenciadas pela Caixa Econômica
    e Banco do Brasil e INSS de obras com excelência técnica.
  </p>

  <div class="hero-cta">
    <a
    <a
  href="https://wa.me/5544999017322?text=Olá!%20Gostaria%20de%20solicitar%20um%20orçamento."
  class="btn btn-cta-large"
  target="_blank"
  rel="noopener noreferrer"
>
  Solicitar orçamento
</a>

</div>

    <a href="#servicos" class="
    tn btn-secondary">
      Conheça nossos serviços
    </a>
  </div>
</div>

<!-- PROJETOS -->
<section id="projetos" class="projects-showcase">

  <div class="container">

    <div class="section-head text-center">
      <span class="eyebrow">Portfólio</span>
      <h2>Projetos em Destaque</h2>
      <p class="lead">
        Arquitetura pensada para unir funcionalidade, estética e valorização do patrimônio.
      </p>
    </div>

    <div class="projects-grid">

  <article class="project-card">
    <img src="/images/projetos/projeto01.png" alt="Projeto 01">
    <div class="project-overlay">
      <h3>Projeto Residencial</h3>
    </div>
  </article>

  <article class="project-card">
    <img src="/images/projetos/projeto02.png" alt="Projeto 02">
    <div class="project-overlay">
      <h3>Área Gourmet</h3>
    </div>
  </article>

  <article class="project-card">
    <img src="/images/projetos/projeto03.jpeg" alt="Projeto 03">
    <div class="project-overlay">
      <h3>Suíte</h3>
    </div>
  </article>

  <article class="project-card">
    <img src="/images/projetos/projeto04.jpg" alt="Projeto 04">
    <div class="project-overlay">
      <h3>Banheiro</h3>
    </div>
  </article>

  <article class="project-card">
    <img src="/images/projetos/projeto05.jpg" alt="Projeto 05">
    <div class="project-overlay">
      <h3>Quarto Menina</h3>
    </div>
  </article>

  <article class="project-card">
    <img src="/images/projetos/projeto06.png" alt="Projeto 06">
    <div class="project-overlay">
      <h3>Lavabo</h3>
    </div>
  </article>

  <article class="project-card">
    <img src="/images/projetos/projeto07.png" alt="Projeto 07">
    <div class="project-overlay">
      <h3>Fachada Residencial</h3>
    </div>
  </article>

  <article class="project-card">
    <img src="/images/projetos/projeto08.png" alt="Projeto 08">
    <div class="project-overlay">
      <h3>Consultório</h3>
    </div>
  </article>

  <article class="project-card">
    <img src="/images/projetos/projeto09.png" alt="Projeto 09">
    <div class="project-overlay">
      <h3>Projeto Comercial</h3>
    </div>
  </article>

</div>

  </div>

</section>

  <!-- SOBRE -->
  <section id="sobre" class="section">
    <div class="container">
      <div class={`who-block ${about ? 'who-block-with-photo' : ''}`}>
        <div class="who-text">
          <span class="eyebrow">Quem atende você</span>
          <h2>Fernanda Okabayashi</h2>
          <div class="divider"></div>
          <p>
            A <strong>Fernanda OKabayashi Arquitetura e Interiores </strong> é a marca-assinatura da arquiteta <strong>Fernanda Okabayashi</strong> — organizada, direta, voltada Projetos Arquitetônicos e Interiores, Avaliações Imobiliárias e redução de INSS de obras
          </p>
          <p>
            Atendemos <strong>Caixa Econômica</strong> e <strong>Banco do Brasil</strong> e Avaliações Particulares, com a organização e a clareza de quem trata cada laudo como peça única.
          </p>
          <p class="lead-quote">
            "Ordem e clareza em cada laudo."
          </p>
        </div>
        {about && (
          <picture class="about-photo-wrap">
            <source srcset={about.mobile} media="(max-width: 768px)" />
            <img src={about.desktop} alt="Fernanda Okabayashi" class="about-photo" />
          </picture>
        )}
   </div>
</div>
</section>
    <!-- SERVIÇOS -->
  <section id="servicos" class="section tinted">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">O que entregamos</span>
        <h2>Serviços</h2>
        <div class="divider"></div>
        <p class="lead">Projetos inteligentes, avaliações confiáveis e regularização especializada para oferecer mais segurança, praticidade e valorização ao seu imóvel.</p>
      </div>

      <div class="grid grid-2">
        <div class="card service-card">
          <h3>Projetos  Arquitetônicos </h3>
          <p>Projetos residenciais e comerciais desenvolvidos para transformar necessidades em espaços funcionais, modernos e personalizados, conciliando estética, conforto e viabilidade técnica.</p>
        </div>
        <div class="card service-card">
          <h3>Laudos avaliação de imóveis</h3>
          <p>Realizamos avaliações imobiliárias seguindo as normas da ABNT e os critérios das instituições financeiras, oferecendo laudos técnicos confiáveis para financiamentos, compra e venda, inventários e diversas outras finalidades..</p>
        </div>
        <div class="card service-card">
          <h3>Projeto de Interiores</h3>
          <p>Criamos ambientes exclusivos que refletem o estilo de cada cliente, com planejamento completo de layout, iluminação, marcenaria e acabamentos, proporcionando beleza, funcionalidade e bem-estar.</p>
        </div>
        <div class="card service-card">
          <h3>INSS de obras </h3>
          <p>Regularização de INSS de Obras para Pessoa Física e Pessoa Jurídica, com acompanhamento técnico especializado.</p>
        </div>
      </div>
    </div>
  </section>

 

  <!-- BLOG PREVIEW -->
  {posts.length > 0 && (
    <section class="section tinted">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">Conteúdo técnico</span>
          <h2>Do blog</h2>
          <div class="divider"></div>
          <p class="lead">Conteúdo autoral sobre avaliação imobiliária, laudos técnicos e financiamento bancário — escrito pela arquiteta a partir do que se vê na prática com Caixa, BB e bancos privados.</p>
        </div>

            <div class="text-center" style="margin-top: 48px;">
          <a href="/blog" class="btn btn-secondary">Ver todos os posts</a>
        </div>
      </div>
    </section>
  )}
<!-- CONTATO -->
<section id="contato" class="section">
  <div class="container">

    <div class="section-head section-head-center">

      <span class="eyebrow">
        Entre em contato
      </span>

      <h2>
        Vamos transformar seu projeto em realidade.
      </h2>

      <div class="divider"></div>

      <p class="lead">
        Conte com a Fernanda Okabayashi Arquitetura para desenvolver projetos arquitetônicos,
        projetos de interiores, avaliações imobiliárias e INSS de obras.
        Estamos prontos para oferecer soluções personalizadas com excelência
        técnica, segurança e compromisso em cada etapa.
      </p>

    </div>

    {(waUrl || mailUrl) && (
      <div class="contact-cta-wrap">

        {waUrl ? (
          <a
            href={waUrl}
            class="btn btn-cta-large"
            target="_blank"
            rel="noopener noreferrer"
          >
            Solicitar orçamento
          </a>
        ) : (
          <a href={mailUrl!} class="btn btn-cta-large">
            Solicitar orçamento
          </a>
        )}

        <p class="contact-cta-sub">
          Arquitetura • Interiores • Avaliação Imobiliária • Regularização de Obras
        </p>

      </div>
    )}

  </div>
</section>
</BaseLayout>

<style>
  .hero {
    --hero-image: linear-gradient(135deg, var(--primary) 0%, var(--dark) 100%);
    --hero-image-mobile: var(--hero-image);
   background: #ffffff;
color: var(--gray-900);
    background-image: var(--hero-image);
    background-size: cover;
    background-position: center 25%;
    background-repeat: no-repeat;}
 .hero{
    background:#fff;
    padding:120px 0 60px;
    min-height:auto;
    color:#222;
}

.hero-overlay{
    display:none;
}

.hero-simple{
    max-width:760px;
}

.hero h1{
    color:#111;
    font-size:clamp(54px,7vw,90px);
    line-height:1.05;
    margin-bottom:28px;
}

.hero .lead{
    color:#555;
    max-width:620px;
    font-size:20px;
    margin-bottom:40px;
}

.hero .eyebrow{
    color:var(--secondary);
    margin-bottom:18px;
}

.hero-inner{
    display:grid;
    grid-template-columns:1.4fr 1fr;
    gap:64px;
    align-items:center;
    position:relative;
    z-index:2;
    width:100%;
}

.hero-text{
    max-width:720px;
}

{ 
display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 64px;
    align-items: center;
    position: relative;
    z-index: 2;
    width: 100%;
  }

  .hero-with-photo .hero-inner {
    grid-template-columns: minmax(0, 720px);
  }

  .hero-cta {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  .hero .btn-secondary {
    border-color: rgba(255,255,255,0.4);
    color: #fff;
  }

  .hero .btn-secondary:hover {
    background: #fff;
    color: var(--primary);
    border-color: #fff;
  }

  .hero-visual {
    display: flex;
    justify-content: center;
    align-items: center;
    opacity: 0.96;
  }

  .hero-visual .hero-mark {
    max-width: 360px;
    width: 100%;
    filter: drop-shadow(0 24px 64px rgba(0,0,0,0.35));
  }

  @media (max-width: 900px) {
    .hero { padding: 96px 0 80px; min-height: 480px; }
    .hero-inner { grid-template-columns: 1fr; }
    .hero-visual { order: -1; }
    .hero-visual .hero-mark { max-width: 200px; }
  }

  .section-head {
    margin-bottom: 64px;
    max-width: 720px;
  }

  .section.tinted .section-head .lead { color: var(--gray-700); }

  .service-card h3 { color: var(--primary); }

  .card-link {
    display: inline-block;
    margin-top: 16px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: var(--secondary);
  }

  .reasons-grid { gap: 48px; }

  .reason-num {
    font-family: var(--display);
    font-size: 56px;
    font-weight: 400;
    color: var(--secondary);
    line-height: 1;
    margin-bottom: 12px;
  }

  .reason h3 { color: var(--primary); }

  .who-block {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
    align-items: start;
    margin-bottom: 80px;
  }

  .who-block-with-photo {
    grid-template-columns: 1.2fr 1fr;
    gap: 80px;
  }

  .who-text p {
    margin-bottom: 16px;
    color: var(--gray-700);
    font-size: 17px;
  }

  .about-photo-wrap {
    aspect-ratio: 4 / 5;
    border-radius: 14px;
    overflow: hidden;
    background: var(--gray-100);
    box-shadow: 0 16px 40px rgba(31, 42, 56, 0.12);
    display: block;
  }
  .about-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .mvv-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .lead-quote {
    font-family: var(--display);
    font-style: italic;
    font-size: 22px;
    line-height: 1.4;
    color: var(--secondary);
    border-left: 3px solid var(--secondary);
    padding-left: 20px;
    margin-top: 24px;
  }

  .mvv-card {
    background: var(--gray-100);
    border-left: 3px solid var(--secondary);
    padding: 28px 28px;
    border-radius: 4px;
  }

  .mvv-card p {
    color: var(--gray-900);
    font-size: 15px;
    margin: 0;
    line-height: 1.6;
  }

  @media (max-width: 900px) {
    .who-block,
    .who-block-with-photo { grid-template-columns: 1fr; gap: 40px; }
    .about-photo-wrap { max-width: 360px; aspect-ratio: 3 / 4; }
    .mvv-row { grid-template-columns: 1fr; gap: 16px; }
  }

  .post-date {
    display: block;
    font-family: var(--body);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--gray-500);
    margin-bottom: 12px;
  }

  .section-head-center {
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }
  .section-head-center .divider { margin-left: auto; margin-right: auto; }

  .contact-cta-wrap {
    text-align: center;
    margin-bottom: 48px;
  }

  .btn-cta-large {
    font-size: 17px;
    padding: 20px 40px;
    background: var(--secondary);
    color: #fff;
    border: 1.5px solid var(--secondary);
    box-shadow: 0 12px 32px rgba(var(--brand-glow-rgb), 0.25);
    transition: all var(--transition);
  }
  .btn-cta-large:hover {
    background: #fff;
    color: var(--secondary);
    border-color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 18px 40px rgba(var(--brand-glow-rgb), 0.32);
  }

 .contact-cta-sub{
    margin-top:16px;
    font-size:14px;
    color:var(--gray-500);
}

/* ===========================
   PROJETOS
=========================== */

.projects-showcase{
    background:#fff;
    padding:110px 0;
}

.projects-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:28px;
    margin-top:50px;
}

.project-card{
    position:relative;
    overflow:hidden;
    border-radius:18px;
    cursor:pointer;
    background:#f3f3f3;
    box-shadow:0 12px 35px rgba(0,0,0,.08);
}

.project-card img{
    width:100%;
    height:360px;
    object-fit:cover;
    display:block;
    transition:.5s;
}

.project-card:hover img{
    transform:scale(1.08);
}

.project-overlay{
    position:absolute;
    inset:0;
    display:flex;
    align-items:flex-end;
    padding:24px;
    background:linear-gradient(
        to top,
        rgba(0,0,0,.65),
        rgba(0,0,0,0)
    );
    opacity:0;
    transition:.35s;
}

.project-card:hover .project-overlay{
    opacity:1;
}

.project-overlay h3{
    color:white;
    font-size:24px;
    font-family:'Playfair Display',serif;
    margin:0;
}

@media(max-width:900px){

.projects-grid{
    grid-template-columns:1fr;
}

.project-card img{
    height:280px;
}

}
.project-overlay{
    position:absolute;
    inset:0;
    display:flex;
    align-items:flex-end;
    padding:28px;
    background:linear-gradient(
        to top,
        rgba(0,0,0,.72),
        rgba(0,0,0,.15),
        transparent
    );

    opacity:0;
    transition:.35s;
}

.project-card:hover .project-overlay{
    opacity:1;
}

.project-info{
    transform:translateY(20px);
    transition:.35s;
}

.project-card:hover .project-info{
    transform:translateY(0);
}

.project-info span{
    display:inline-block;
    color:#d9b97c;
    text-transform:uppercase;
    letter-spacing:3px;
    font-size:12px;
    margin-bottom:10px;
    font-weight:600;
}

.project-info h3{
    color:#fff;
    font-family:'Playfair Display', serif;
    font-size:28px;
    margin:0;
}