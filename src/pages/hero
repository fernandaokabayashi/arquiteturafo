---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { contacts, whatsappUrl, emailUrl, heroImages, aboutPhotos } from '../lib/contacts';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const waUrl = whatsappUrl();
const mailUrl = emailUrl();
const hero = heroImages();
const about = aboutPhotos();

// CSS escape simples para URLs em background-image
function cssUrl(s: string) {
  return s.replace(/[\\'"]/g, '\\$&');
}
---

<BaseLayout
  title= "Fernanda Okabayashi Arquitetura e Interiores | Avaliação de Imóveis | INSS de obras"
>
<!-- HERO -->
<section class="hero" id="topo">
  <div class="container hero-grid">

    <div class="hero-content">

      <span class="eyebrow">
        Fernanda Okabayashi Arquitetura e Interiores
      </span>

      <h1>
        Arquitetura<br />
        que transforma<br />
        espaços.
      </h1>

      <p class="hero-description">
        Projetos arquitetônicos, projetos de interiores,
        avaliações imobiliárias credenciadas pela Caixa Econômica Federal
        e Banco do Brasil, além da regularização de INSS de obras.
      </p>

      <div class="hero-buttons">

        <a
          href={waUrl}
          class="btn btn-cta-large"
          target="_blank"
          rel="noopener noreferrer"
        >
          Solicitar orçamento
        </a>

        <a
          href="#projetos"
          class="btn btn-secondary"
        >
          Ver projetos
        </a>

      </div>

    </div>

    <div class="hero-image">

      <img
        src="/images/projetos/projeto01.png"
        alt="Projeto Residencial"
      />

    </div>

  </div>
</section>

/* ===========================
   PROJETOS
=========================== */

.projects-showcase{
    background:#fff;
    padding:110px 0;
}

.projects-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:28px;
    margin-top:50px;
}

.project-card{
    position:relative;
    overflow:hidden;
    border-radius:18px;
    cursor:pointer;
    background:#f3f3f3;
    box-shadow:0 12px 35px rgba(0,0,0,.08);
}

.project-card img{
    width:100%;
    height:360px;
    object-fit:cover;
    display:block;
    transition:.5s;
}

.project-card:hover img{
    transform:scale(1.08);
}

.project-overlay{
    position:absolute;
    inset:0;
    display:flex;
    align-items:flex-end;
    padding:24px;
    background:linear-gradient(
        to top,
        rgba(0,0,0,.65),
        rgba(0,0,0,0)
    );
    opacity:0;
    transition:.35s;
}

.project-card:hover .project-overlay{
    opacity:1;
}

.project-overlay h3{
    color:white;
    font-size:24px;
    font-family:'Playfair Display',serif;
    margin:0;
}

@media(max-width:900px){

.projects-grid{
    grid-template-columns:1fr;
}

.project-card img{
    height:280px;
}

}
.project-overlay{
    position:absolute;
    inset:0;
    display:flex;
    align-items:flex-end;
    padding:28px;
    background:linear-gradient(
        to top,
        rgba(0,0,0,.72),
        rgba(0,0,0,.15),
        transparent
    );

    opacity:0;
    transition:.35s;
}

.project-card:hover .project-overlay{
    opacity:1;
}

.project-info{
    transform:translateY(20px);
    transition:.35s;
}

.project-card:hover .project-info{
    transform:translateY(0);
}

.project-info span{
    display:inline-block;
    color:#d9b97c;
    text-transform:uppercase;
    letter-spacing:3px;
    font-size:12px;
    margin-bottom:10px;
    font-weight:600;
}

.project-info h3{
    color:#fff;
    font-family:'Playfair Display', serif;
    font-size:28px;
    margin:0;
}
