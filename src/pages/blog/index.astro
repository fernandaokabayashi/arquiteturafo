---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title="Blog — F.O Arquitetura"
  description="Conteúdo técnico autoral sobre avaliação imobiliária, vistoria e decisões patrimoniais — escrito pela arquiteta Fernanda."
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Conteúdo técnico</span>
      <h1>Blog.</h1>
      <p class="lead">
        Conteúdo autoral sobre avaliação imobiliária, vistoria e decisões patrimoniais — escrito pela arquiteta sobre o que vê na prática.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {posts.length === 0 ? (
        <div class="empty">
          <p>Os primeiros posts estão a caminho.</p>
        </div>
      ) : (
        <div class="posts-list">
          {posts.map((post) => (
            <article class="post-item">
              <div class="post-meta">
                <time datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' })}
                </time>
                {post.data.tags.length > 0 && (
                  <span class="post-tags">{post.data.tags.slice(0, 2).join(' · ')}</span>
                )}
              </div>
              <h2><a href={`/blog/${post.id}`}>{post.data.title}</a></h2>
              <p>{post.data.description}</p>
              <a href={`/blog/${post.id}`} class="post-link">Ler artigo →</a>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding: 80px 0 56px;
    background: var(--gray-100);
    border-bottom: 1px solid var(--gray-300);
  }

  .page-hero h1 { color: var(--primary); margin: 8px 0 16px; }
  .page-hero .lead { color: var(--gray-700); margin: 0; max-width: 640px; }

  .posts-list {
    display: flex;
    flex-direction: column;
    gap: 48px;
    max-width: 820px;
  }

  .post-item {
    padding-bottom: 48px;
    border-bottom: 1px solid var(--gray-100);
  }

  .post-item:last-child { border-bottom: 0; }

  .post-meta {
    display: flex;
    gap: 16px;
    align-items: center;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--gray-700);
    margin-bottom: 12px;
  }

  .post-tags { color: var(--secondary); }

  .post-item h2 {
    font-size: clamp(24px, 3vw, 34px);
    margin-bottom: 12px;
  }

  .post-item h2 a {
    color: var(--primary);
  }

  .post-item h2 a:hover {
    color: var(--secondary);
  }

  .post-item p {
    color: var(--gray-700);
    font-size: 17px;
    margin-bottom: 16px;
  }

  .post-link {
    font-size: 14px;
    font-weight: 600;
    color: var(--secondary);
    letter-spacing: 0.3px;
  }

  .empty {
    text-align: center;
    padding: 64px 0;
    color: var(--gray-500);
  }
</style>
