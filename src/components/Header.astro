---
import { whatsappUrl, emailUrl } from '../lib/contacts';

const navItems = [
  { href: '/#sobre', label: 'Sobre' },
  { href: '/#servicos', label: 'Serviços' },
  { href: '/#projetos', label: 'Projetos' },
  { href: '/blog', label: 'Blog' },
  { href: '/#contato', label: 'Contato' },
];

const waUrl = whatsappUrl();
const mailUrl = emailUrl();
const ctaHref = waUrl ?? mailUrl;
const ctaTarget = waUrl ? '_blank' : undefined;
const ctaRel = waUrl ? 'noopener noreferrer' : undefined;
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="logo" aria-label="F.O Arquitetura — Início">
<img
    src="/logo-branca.png"
  alt="Fernanda Okabayashi Arquitetura e Interiores"
/>
    </a>

    <nav class="nav-desktop" aria-label="Navegação principal">
      <ul>
        {navItems.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

   
    <button class="nav-toggle" aria-label="Abrir menu" aria-expanded="false" aria-controls="nav-mobile">
      <span></span><span></span><span></span>
    </button>
  </div>

  <nav class="nav-mobile" id="nav-mobile" aria-hidden="true">
    <ul>
      {navItems.map((item) => (
        <li><a href={item.href}>{item.label}</a></li>
      ))}
      {ctaHref && (
        <li>
          <a href={ctaHref} class="btn btn-brand" target={ctaTarget} rel={ctaRel}>WhatsApp</a>
        </li>
      )}
    </ul>
  </nav>
</header>

<style>
  .site-header{
    position:sticky;
    top:0;
    z-index:1000;
    background:#fff;
    border-bottom:1px solid #ececec;
    box-shadow:0 4px 24px rgba(0,0,0,.05);
}
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
   border-bottom:1px solid #ececec;
box-shadow:0 8px 30px rgba(0,0,0,.04);
  }

.header-inner{
    display:grid;
    grid-template-columns:320px 1fr;
    align-items:center;
    height:90px;
    gap:60px;
}

  .logo {
    display: inline-flex;
    align-items: center;
  }


@media (max-width: 600px) 
  .header-inner{
    display:grid;
    grid-template-columns:260px 1fr;
    align-items:center;
    height:90px;
    gap:40px;
} 

  .logo img{
    max-height:58px;
  }

.logo img{
    max-height:70px;
    width:auto;
    display:block;
    object-fit:contain;
}
.nav-desktop{
    width:100%;
}

.nav-desktop ul{
    display:flex;
    justify-content:center;
    align-items:center;
    gap:52px;
    list-style:none;
    margin:0;
    padding:0;
}

  .nav-desktop a {
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.3px;
    color: var(--gray-700);
    padding: 8px 0;
    border-bottom: 2px solid transparent;
    transition: all var(--transition);
  }

  .nav-desktop a:hover {
    color: var(--primary);
    border-bottom-color: var(--secondary);
  }

.btn-cta{
    display:flex;
    align-items:center;
    justify-content:center;
    width:180px;
    height:54px;
    border:2px solid var(--secondary);
    border-radius:8px;
    background:#fff;
    color:var(--secondary);
    font-weight:600;
}

.btn-cta:hover{
    background:var(--secondary);
    color:#fff;
}

  .nav-toggle {
    display: none;
    background: transparent;
    border: 0;
    padding: 8px;
    cursor: pointer;
    flex-direction: column;
    gap: 4px;
  }

  .nav-toggle span {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--primary);
    transition: all var(--transition);
  }

  .nav-mobile {
    display: none;
    padding: 24px var(--gutter);
    border-top: 1px solid var(--gray-100);
  }

  .nav-mobile ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .nav-mobile a {
    display: block;
    padding: 12px 0;
    font-size: 16px;
    color: var(--gray-900);
  }

  .nav-mobile.open {
    display: block;
  }

  @media (max-width: 900px) {
    .nav-desktop, .btn-cta { display: none; }
    .nav-toggle { display: flex; }
  }
</style>

<script>
  const toggle = document.querySelector('.nav-toggle');
  const mobile = document.getElementById('nav-mobile');
  toggle?.addEventListener('click', () => {
    const open = mobile?.classList.toggle('open');
    toggle.setAttribute('aria-expanded', String(!!open));
    mobile?.setAttribute('aria-hidden', String(!open));
  });
</script>
