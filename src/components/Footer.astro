---
import { contacts, whatsappUrl, instagramUrl, emailUrl } from '../lib/contacts';

const year = new Date().getFullYear();
const waUrl = whatsappUrl();
const igUrl = instagramUrl();
const mailUrl = emailUrl();
---

<footer class="site-footer">
  <div class="container footer-content">

    <img
      src="/SUBLOGO0.png"
      alt="Fernanda Okabayashi Arquitetura e Interiores"
      class="footer-logo"
    />

    <p class="footer-description">
      Arquitetura • Interiores • Avaliação Imobiliária • INSS de Obras
    </p>

    <div class="footer-links">

      {waUrl && (
        <a href={waUrl} target="_blank" rel="noopener noreferrer">
          WhatsApp
        </a>
      )}

      {igUrl && (
        <a href={igUrl} target="_blank" rel="noopener noreferrer">
          Instagram
        </a>
      )}

      {mailUrl && (
        <a href={mailUrl}>
          E-mail
        </a>
      )}

    </div>

    <div class="footer-bottom">
      © {year} Fernanda Okabayashi Arquitetura e Interiores.
      Todos os direitos reservados.
    </div>
<section class="office-section">

  <div class="container office-grid">

    <div class="office-info">

        <p>
            COLORADO - PR
      </p>

      <p>
        📞 (44) 999901-7322
      </p>

      <p>
        ✉️ arquitetura.fo@gmail.com
      </p>

      <p>
        📷 @arquiteturafo
      </p>

     
    </div>

  </div>

</section>
  </div>
</footer>

<style>
.site-footer {
  background: #ffffff;
  color: var(--gray-700);
  padding: 80px 0 40px;
  border-top: 1px solid #ececec;
}

.footer-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.footer-logo {
  width: 380px;
  height: auto;
  margin-bottom: 28px;
}

.footer-description {
  max-width: 700px;
  color: var(--gray-500);
  line-height: 1.8;
  margin-bottom: 32px;
  font-size: 15px;
}

.footer-links {
  display: flex;
  gap: 36px;
  flex-wrap: wrap;
  justify-content: center;
  margin-bottom: 40px;
}

.footer-links a {
  color: var(--gray-700);
  font-size: 15px;
  font-weight: 500;
  transition: all .3s ease;
}

.footer-links a:hover {
  color: var(--secondary);
}

.footer-bottom {
  width: 100%;
  margin-top: 10px;
  padding-top: 24px;
  border-top: 1px solid #ececec;
  text-align: center;
  color: var(--gray-500);
  font-size: 13px;
}

@media (max-width:768px){

  .footer-logo{
      width:180px;
  }

  .footer-links{
      flex-direction:column;
      gap:18px;
  }

}

.footer-links a{
    color:#fff;
    font-size:15px;
    transition:.3s;
}

.footer-links a:hover{
    color:var(--secondary);
}

.footer-bottom{
    width:100%;
    border-top:1px solid rgba(255,255,255,.10);
    padding-top:25px;
    font-size:13px;
    color:rgba(255,255,255,.50);
}

@media(max-width:768px){

.footer-logo{
width:180px;
}

.footer-links{
flex-direction:column;
gap:18px;
}

  }
</style>
