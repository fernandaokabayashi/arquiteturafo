  </a>
)}

<style>
.floating-whatsapp{
    position:fixed;
    right:24px;
    bottom:24px;
    width:68px;
    height:68px;
    border-radius:50%;
    background:#25D366;
    display:flex;
    justify-content:center;
    align-items:center;
    box-shadow:0 12px 30px rgba(0,0,0,.25);
    z-index:99999;
    transition:.3s;
}

.floating-whatsapp:hover{
    transform:scale(1.1);
}

.floating-whatsapp svg{
    width:34px;
    height:34px;
}
</style>