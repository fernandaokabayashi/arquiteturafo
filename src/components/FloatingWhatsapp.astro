---
import { whatsappUrl } from '../lib/contacts';

const waUrl = "https://wa.me/5544999017322";
---

{waUrl && (
  <a
    href={waUrl}
    class="floating-whatsapp"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Falar pelo WhatsApp"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32">
      <path fill="#fff" d="M19.11 17.24c-.29-.15-1.69-.84-1.95-.94-.26-.09-.45-.14-.64.15-.19.29-.73.94-.89 1.13-.16.19-.33.22-.61.07-.29-.15-1.21-.45-2.3-1.44-.85-.75-1.42-1.68-1.59-1.96-.17-.29-.02-.44.13-.58.13-.13.29-.33.44-.49.15-.17.2-.29.3-.48.1-.19.05-.36-.02-.51-.08-.15-.64-1.55-.88-2.12-.23-.56-.47-.48-.64-.49l-.55-.01c-.19 0-.49.07-.75.36-.26.29-.98.96-.98 2.35s1.01 2.73 1.15 2.92c.14.19 1.99 3.04 4.82 4.26.67.29 1.19.46 1.6.59.67.21 1.28.18 1.76.11.54-.08 1.69-.69 1.93-1.36.24-.67.24-1.25.17-1.36-.07-.11-.26-.18-.55-.33z"/>
